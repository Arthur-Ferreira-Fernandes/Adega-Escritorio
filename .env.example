DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=changeme-generate-a-real-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Sem HTTPS configurado no nginx ainda — mantenha essas quatro desligadas
# até haver certificado TLS de verdade na frente do app, senão o login
# e o redirecionamento quebram.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

DATABASE_URL=postgres://adega:adega@db:5432/adega
POSTGRES_DB=adega
POSTGRES_USER=adega
POSTGRES_PASSWORD=adega

REDIS_URL=redis://redis:6379/0
